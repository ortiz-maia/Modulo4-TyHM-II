{UTF-8}
FRACCION DE MUERTE=0.01
	~	
	~		|

MUERTES=(POBLACION-1e+07)*FRACCION DE MUERTE
	~	
	~		|

NACIMIENTOS=POBLACION*TASA DE NATALIDAD/1000
	~	
	~		|

POBLACION= INTEG (NACIMIENTOS-MUERTES,
		POBLACION INICIAL)
	~	
	~		|

POBLACION INICIAL=3e+07
	~	
	~		|

TASA DE NATALIDAD = WITH LOOKUP (Time,
		([(1980,5)-(2030,35)],(1980,0), (1990,0), (2000,0), (2300,0)))
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 1980
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

